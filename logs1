def analyze():
    import pandas as pd
    import json
    
    # Load data from jsonl files
    bills_data = []
    invoices_data = []
    
    with open('model_http_retriever_query_Bill_dd5df1.jsonl', 'r') as bills_f:
        for line in bills_f:
            bills_data.append(json.loads(line))
    
    with open('model_http_retriever_query_Invoice_3be6a1.jsonl', 'r') as invoices_f:
        for line in invoices_f:
            invoices_data.append(json.loads(line))
    
    # Extract relevant columns
    bill_lines = []
    for bill_entry in bills_data:
        for bill in bill_entry['QueryResponse'].get('Bill', []):
            for line in bill['Line']:
                bill_lines.append({
                    'ItemName': line['ItemBasedExpenseLineDetail']['ItemRef']['name'],
                    'Cost': line['ItemBasedExpenseLineDetail']['UnitPrice'],
                    'Qty': line['ItemBasedExpenseLineDetail']['Qty'],
                    'Amount': line['ItemBasedExpenseLineDetail']['Amount']
                })
    bills_df = pd.DataFrame(bill_lines)

    invoice_lines = []
    for invoice_entry in invoices_data:
        for invoice in invoice_entry['QueryResponse'].get('Invoice', []):
            for line in invoice['Line']:
                if 'SalesItemLineDetail' in line['DetailType']:
                    invoice_lines.append({
                        'ItemName': line['SalesItemLineDetail']['ItemRef']['name'],
                        'SalePrice': line['SalesItemLineDetail']['UnitPrice'],
                        'Qty': line['SalesItemLineDetail']['Qty'],
                        'Amount': line['SalesItemLineDetail']['Amount']
                    })
    invoices_df = pd.DataFrame(invoice_lines)

    # Merge dataframes on ItemName
    combined_df = pd.merge(bills_df, invoices_df, on='ItemName', suffixes=('_Cost', '_Sale'))

    # Calculate Markup and sort
    combined_df['Markup'] = ((combined_df['SalePrice'] - combined_df['Cost']) / combined_df['Cost']) * 100
    sorted_df = combined_df.sort_values(by='Markup', ascending=False)

    # Return data
    return sorted_df[['ItemName', 'Cost', 'SalePrice', 'Markup']].drop_duplicates().reset_index(drop=True)

