def analyze():
    import pandas as pd
    import json
    from collections import defaultdict

    # Load data from jsonl files
    with open('model_http_retriever_query_Bill_dd5df1.jsonl', 'r') as f:
        bills_data = json.load(f)

    with open('model_http_retriever_query_Invoice_3be6a1.jsonl', 'r') as f:
        invoices_data = json.load(f)

    # Normalize JSON data to flat tables
    bills = pd.json_normalize(bills_data['QueryResponse']['Bill'], 'Line',
                              ['Id', 'VendorRef.name', 'TxnDate'],
                              record_prefix='Line_', meta_prefix='Bill_')

    invoices = pd.json_normalize(invoices_data['QueryResponse']['Invoice'], 'Line',
                                 ['Id', 'CustomerRef.name', 'TxnDate'],
                                 record_prefix='Line_', meta_prefix='Invoice_')
    
    # Calculate cost per pound from bills
    bills['CostPerPound'] = bills['Line_Amount'] / bills['Line_ItemBasedExpenseLineDetail.Qty']
    
    # Map from item value to cost
    cost_per_pound_map = dict(zip(bills['Line_ItemBasedExpenseLineDetail.ItemRef.value'], bills['CostPerPound']))

    # Add cost per pound to invoice lines using map
    invoices['CostPerPound'] = invoices['Line_SalesItemLineDetail.ItemRef.value'].map(cost_per_pound_map)
    invoices['Cost'] = invoices['Line_SalesItemLineDetail.Qty'] * invoices['CostPerPound']
    
    # Calculate total revenue, total cost and gross margin per customer
    analysis = invoices.groupby('Invoice_CustomerRef.name').agg(
        TotalRevenue=pd.NamedAgg(column='Line_Amount', aggfunc='sum'),
        TotalCost=pd.NamedAgg(column='Cost', aggfunc='sum'),
    )
    analysis['GrossMargin'] = analysis['TotalRevenue'] - analysis['TotalCost']
    
    # Sort by highest gross margin
    analysis.sort_values(by='GrossMargin', ascending=False, inplace=True)
    
    return analysis.reset_index()

