def analyze():
    import pandas as pd
    import json
    
    # Load JSONL data from the retrieved files
    with open('model_http_retriever_query_Bill_dd5df1.jsonl', 'r') as f:
        bills_data = [json.loads(line) for line in f]
        
    with open('model_http_retriever_query_Invoice_3be6a1.jsonl', 'r') as f:
        invoices_data = [json.loads(line) for line in f]
    
    # Flattening JSON data for the "Line" entries
    def extract_lines(data, line_type='bill'):
        lines = []
        if line_type == 'bill':
            for record in data['QueryResponse']['Bill']:
                for line in record['Line']:
                    line['TxnDate'] = record['TxnDate']
                    line['VendorRef'] = record['VendorRef']['name'] if 'VendorRef' in record else None
                    lines.append(line)
        elif line_type == 'invoice':
            for record in data['QueryResponse']['Invoice']:
                for line in record['Line']:
                    line['TxnDate'] = record['TxnDate']
                    line['CustomerRef'] = record['CustomerRef']['name'] if 'CustomerRef' in record else None
                    lines.append(line)
        return lines

    # Extract data
    bills_lines = extract_lines(bills_data[0], line_type='bill')
    invoices_lines = extract_lines(invoices_data[0], line_type='invoice')

    # Convert to pandas DataFrame
    bills_df = pd.json_normalize(bills_lines)
    invoices_df = pd.json_normalize(invoices_lines)
    
    # Filter columns to necessary ones
    bills_df = bills_df[['TxnDate', 'VendorRef', 'Amount', 'DetailType', 'ItemBasedExpenseLineDetail.ItemRef.value', 'ItemBasedExpenseLineDetail.UnitPrice', 'ItemBasedExpenseLineDetail.Qty']]
    invoices_df = invoices_df[['TxnDate', 'CustomerRef', 'Amount', 'DetailType', 'SalesItemLineDetail.ItemRef.value', 'SalesItemLineDetail.UnitPrice', 'SalesItemLineDetail.Qty']]
    
    # Calculate per pound cost
    bills_df['CostPerPound'] = bills_df['Amount'] / (bills_df['ItemBasedExpenseLineDetail.UnitPrice'] * bills_df['ItemBasedExpenseLineDetail.Qty'])
    
    # Match invoice items with bill items to get cost per pound
    merged_df = pd.merge(invoices_df, bills_df, left_on='SalesItemLineDetail.ItemRef.value', right_on='ItemBasedExpenseLineDetail.ItemRef.value', how='left', suffixes=('_invoice', '_bill'))
    
    # Calculate cost and revenue for matched items
    matched_items = merged_df.dropna(subset=['CostPerPound'])
    matched_items['Cost'] = matched_items['SalesItemLineDetail.Qty'] * matched_items['CostPerPound']
    matched_items['FilteredRevenue'] = matched_items['Amount_invoice']

    # Calculate gross margin
    matched_items['GrossMargin'] = matched_items['FilteredRevenue'] - matched_items['Cost']

    # Group by customers and calculate total revenue and gross margin
    result_df = matched_items.groupby('CustomerRef').agg({'FilteredRevenue': 'sum', 'Cost': 'sum', 'GrossMargin': 'sum'}).sort_values(by='GrossMargin', ascending=False)

    return result_df.reset_index()
