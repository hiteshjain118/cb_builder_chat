def analyze():
    import pandas as pd
    
    # Load data from jsonl files
    bills = pd.read_json('model_http_retriever_query_Bill_dd5df1.jsonl', lines=True)
    invoices = pd.read_json('model_http_retriever_query_Invoice_3be6a1.jsonl', lines=True)

    # Extract relevant columns (Assuming successful extraction of sample response key)
    bills_data = bills['QueryResponse'].apply(pd.Series)['Bill'].dropna()
    invoices_data = invoices['QueryResponse'].apply(pd.Series)['Invoice'].dropna()

    # Normalize json fields
    bills_df = pd.json_normalize(bills_data.explode())
    invoices_df = pd.json_normalize(invoices_data.explode())

    # Compute total cost from bills
    total_cost = bills_df['TotalAmt'].sum()

    # Group by customer and compute total revenue
    revenue_per_customer = invoices_df.groupby('CustomerRef.name')['TotalAmt'].sum().reset_index()

    # Calculate gross margin for each customer assuming cost is the total cost from all bills
    revenue_per_customer['TotalCost'] = total_cost
    
    # Calculate gross margin
    revenue_per_customer['GrossMargin'] = revenue_per_customer['TotalAmt'] - revenue_per_customer['TotalCost']
    
    # Sort by highest gross margin
    result_df = revenue_per_customer.sort_values(by='GrossMargin', ascending=False)
    
    # Return result dataframe
    return result_df.head()
