def analyze():
    import pandas as pd
    
    # Load Bill data
    bill_data = []
    with open('qb_user_data_retriever_query_Bill_0715cd.jsonl', 'r') as file:
        for line in file:
            bill_data.append(eval(line))
    
    # Load Item data
    item_data = []
    with open('qb_user_data_retriever_query_Item_6aa95c.jsonl', 'r') as file:
        for line in file:
            item_data.append(eval(line))
    
    # Extract relevant Bill data
    bill_lines = []
    total_qty = 0
    total_amount = 0
    
    for bill in bill_data:
        if 'QueryResponse' in bill and 'Bill' in bill['QueryResponse']:
            for b in bill['QueryResponse']['Bill']:
                if b['TxnDate'] == '2025-08-16':
                    for line in b['Line']:
                        item_ref = line['ItemBasedExpenseLineDetail']['ItemRef']['value']
                        qty = line['ItemBasedExpenseLineDetail']['Qty']
                        amount = line['Amount']
                        unit_price = line['ItemBasedExpenseLineDetail']['UnitPrice']
                        bill_lines.append({'ItemRef': item_ref, 'Qty': qty, 'Amount': amount, 'UnitPrice': unit_price})
                        total_qty += qty
                        total_amount += amount

    # Extract relevant Item data
    item_lines = []
    
    for item in item_data:
        if 'QueryResponse' in item and 'Item' in item['QueryResponse']:
            for i in item['QueryResponse']['Item']:
                item_id = i['Id']
                item_name = i['Name']
                unit_price = i['UnitPrice']
                purchase_cost = i['PurchaseCost'] if 'PurchaseCost' in i else None
                item_lines.append({'ItemRef': item_id, 'Name': item_name, 'UnitPrice': unit_price, 'PurchaseCost': purchase_cost})

    # Create DataFrames
    df_bill = pd.DataFrame(bill_lines)
    df_item = pd.DataFrame(item_lines)
    
    # Merge Bill and Item data
    merged_df = pd.merge(df_bill, df_item, on='ItemRef', suffixes=('_Bill', '_Item'))

    # Calculate pricing markup
    merged_df['Markup'] = (merged_df['UnitPrice_Item'] - merged_df['UnitPrice_Bill']) / merged_df['UnitPrice_Bill'] * 100
    
    # Calculate total markup across all items in the bill
    merged_df['TotalMarkup'] = merged_df.apply(lambda row: (row['UnitPrice_Item'] - row['UnitPrice_Bill']) * row['Qty'], axis=1)
    total_markup_sum = merged_df['TotalMarkup'].sum()
    
    # Final result
    result_df = merged_df[['ItemRef', 'Name', 'Qty', 'Amount', 'UnitPrice_Bill', 'UnitPrice_Item', 'Markup', 'TotalMarkup']]
    result_df = result_df.sort_values(by=['Markup'], ascending=False)
    
    return result_df

analyze()
