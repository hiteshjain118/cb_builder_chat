def analyze():
    import pandas as pd
    
    # Load Bill data from JSONL
    bill_data = pd.read_json('qb_user_data_retriever_query_Bill_0715cd.jsonl', lines=True)
    item_data = pd.read_json('qb_user_data_retriever_query_Item_6aa95c.jsonl', lines=True)
    
    # Extract relevant sections safely
    try:
        bill_lines = bill_data['QueryResponse'][0]['Bill'][0]['Line']
    except KeyError:
        return pd.DataFrame(columns=['ItemId', 'ItemName', 'CostPrice', 'SalesPrice', 'MarkupPercent'])
    
    try:
        item_details = item_data['QueryResponse']['Item']
    except KeyError:
        return pd.DataFrame(columns=['ItemId', 'ItemName', 'CostPrice', 'SalesPrice', 'MarkupPercent'])

    # Create dataframe for bill lines
    bill_df = pd.DataFrame(bill_lines)
    bill_df['ItemId'] = bill_df['ItemBasedExpenseLineDetail'].apply(lambda x: x['ItemRef']['value'])
    bill_df['CostPrice'] = bill_df['ItemBasedExpenseLineDetail'].apply(lambda x: x['UnitPrice'])
    bill_df['ItemName'] = bill_df['ItemBasedExpenseLineDetail'].apply(lambda x: x['ItemRef']['name'])

    # Create dataframe for items
    item_df = pd.DataFrame(item_details)
    item_df['ItemId'] = item_df['Id']
