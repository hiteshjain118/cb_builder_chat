    # Merge the two dataframes on ItemId
    merged_df = bill_df.merge(item_df, on='ItemId', how='inner')
    
    # Calculate markup
    merged_df['MarkupPercent'] = ((merged_df['SalesPrice'] - merged_df['CostPrice']) / merged_df['CostPrice']) * 100
    
    # Prepare result dataframe
    result_df = merged_df[['ItemId', 'ItemName', 'CostPrice', 'SalesPrice', 'MarkupPercent']]
    return result_df

analyze()

