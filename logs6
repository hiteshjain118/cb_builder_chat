import pandas as pd
import numpy as np
import json

def analyze():
    # Load JSONL files
    bill_data = []
    item_data = []

    # Load Bill data
    with open('qb_user_data_retriever_query_Bill_0715cd.jsonl') as f:
        for line in f:
            parsed_line = json.loads(line)
            if 'Bill' in parsed_line['QueryResponse']:
                bill_data.append(pd.json_normalize(parsed_line['QueryResponse']['Bill'], record_path=['Line'], 
                                                   meta=['Id', 'TxnDate', ['VendorRef', 'name']], 
                                                   meta_prefix='Bill.', errors='ignore'))

    # Load Item data
    with open('qb_user_data_retriever_query_Item_6aa95c.jsonl') as f:
        for line in f:
            parsed_line = json.loads(line)
            if 'Item' in parsed_line['QueryResponse']:
                item_data.append(pd.json_normalize(parsed_line['QueryResponse']['Item']))

    bill_df = pd.concat(bill_data, ignore_index=True)
    item_df = pd.concat(item_data, ignore_index=True)

    # Filter and merge data
    bill_df['ItemRef.value'] = bill_df['ItemBasedExpenseLineDetail.ItemRef.value']
    item_df['Id'] = item_df['Id'].astype(str)
    merged_df = bill_df.merge(item_df, left_on='ItemRef.value', right_on='Id', suffixes=('_bill', '_item'))

    # Calculate markup based on differences between sales price (Item.UnitPrice) and cost price (Bill.UnitPrice)
    merged_df['Markup'] = merged_df['UnitPrice'] - merged_df['ItemBasedExpenseLineDetail.UnitPrice']

    # Prepare the final result
    merged_df['ItemRef.name'] = merged_df['ItemBasedExpenseLineDetail.ItemRef.name']
    
    result_df = merged_df[['Bill.VendorRef.name', 'ItemRef.name', 'ItemBasedExpenseLineDetail.UnitPrice', 'UnitPrice', 'Markup', 'ItemBasedExpenseLineDetail.Qty', 'Amount']]
    result_df = result_df.rename(columns={'Bill.VendorRef.name': 'VendorName', 'ItemRef.name': 'ItemName', 'ItemBasedExpenseLineDetail.UnitPrice': 'CostPrice', 'UnitPrice': 'SalesPrice', 'ItemBasedExpenseLineDetail.Qty': 'Qty'})
    result_df = result_df.sort_values(by='Markup', ascending=False)

    return result_df.head(10)
