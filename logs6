result_df = result_df.rename(columns={'Bill.VendorRef.name': 'VendorName', 'ItemRef.name': 'ItemName', 'ItemBasedExpenseLineDetail.UnitPrice': 'UnitPrice', 'ItemBasedExpenseLineDetail.Qty': 'Qty'})
result_df = result_df.sort_values(by='PricingMarkup', ascending=False)

result_df.head(10)
