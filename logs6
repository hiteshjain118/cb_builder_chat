import numpy as np

# Load JSONL files
bill_data = []
item_data = []

# Load Bill data
with open('qb_user_data_retriever_query_Bill_0715cd.jsonl') as f:
    for line in f:
        bill_data.append(pd.json_normalize(eval(line)['Bill']))
        
# Load Item data
with open('qb_user_data_retriever_query_Item_6aa95c.jsonl') as f:
    for line in f:
        item_data.append(pd.json_normalize(eval(line)['Item']))

