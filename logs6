item_df = pd.concat(item_data, ignore_index=True)

# Merge Bill and Item data on ItemRef Id and Item Id
bill_items = []

for index, row in bill_df.iterrows():
    for line in row['Line']:
        bill_item = {
            'Id': row['Id'],
            'TxnDate': row['TxnDate'],
            'VendorName': row['VendorRef.name'],
            'ItemId': line['ItemBasedExpenseLineDetail.ItemRef.value'],
            'ItemName': line['ItemBasedExpenseLineDetail.ItemRef.name'],
            'UnitPrice': line['ItemBasedExpenseLineDetail.UnitPrice'],
            'Qty': line['ItemBasedExpenseLineDetail.Qty'],
            'Amount': line['Amount']
        }
        bill_items.append(bill_item)
        
bill_items_df = pd.DataFrame(bill_items)
bill_items_df['ItemId'] = bill_items_df['ItemId'].astype(str)

# Merge the data
