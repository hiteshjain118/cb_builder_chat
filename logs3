def analyze():
    import pandas as pd
    import json

    # Load the data
    with open('qb_user_data_retriever_query_Bill_5b51e4.jsonl', 'r') as file:
        bills_data = json.loads(list(file)[-1])['QueryResponse']['Bill']

    with open('qb_user_data_retriever_query_Item_6aa95c.jsonl', 'r') as file:
        items_data = json.loads(list(file)[-1])['QueryResponse']['Item']

    # Initialize lists
    bill_items = []
    item_list = []

    # Extract details from bills
    for bill in bills_data:
        for line in bill['Line']:
            line_detail = line['ItemBasedExpenseLineDetail']
            bill_items.append({
                'Item_Id': line_detail['ItemRef']['value'],
                'UnitPrice_Bill': line_detail['UnitPrice']
            })

    # Extract details from items
    for item in items_data:
        if 'UnitPrice' in item:
            item_list.append({
                'Item_Id': item['Id'],
                'UnitPrice_Item': item['UnitPrice'],
                'Item_Name': item['Name']
            })

    bills_df = pd.DataFrame(bill_items)
    items_df = pd.DataFrame(item_list)

    # Merge dataframes on Item_Id
    merged_df = pd.merge(bills_df, items_df, on='Item_Id', how='left')

    # Calculate markup and markup percentage
    merged_df['Markup'] = merged_df['UnitPrice_Item'] - merged_df['UnitPrice_Bill']
    merged_df['Markup_Percent'] = (merged_df['Markup'] / merged_df['UnitPrice_Bill']) * 100

    return merged_df[['Item_Id', 'Item_Name', 'Markup', 'Markup_Percent']].fillna('N/A')

