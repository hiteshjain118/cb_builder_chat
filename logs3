        # Correct JSON handling
        bills_data = json.loads(list(file)[-1])['QueryResponse']['Bill']

    with open('qb_user_data_retriever_query_Item_6aa95c.jsonl', 'r') as file:
        # Correct JSON handling
        items_data = json.loads(list(file)[-1])['QueryResponse']['Item']

    # Extract details from bills
    bill_items = pd.json_normalize(
        [(line['ItemBasedExpenseLineDetail']['ItemRef']['value'], line['ItemBasedExpenseLineDetail']['UnitPrice'])
         for bill in bills_data for line in bill['Line']], 
        meta_prefix=None, 
        record_prefix='Bill_', 
        meta_names=['Item_Id', 'UnitPrice_Bill']
    )

    # Extract details from items
    items_df = pd.json_normalize(
        [(item['Id'], item['UnitPrice'], item.get('Name', ''))
         for item in items_data if 'UnitPrice' in item],
        meta_prefix=None, 
        record_prefix='Item_',
        meta_names=['Item_Id', 'UnitPrice_Item', 'Item_Name']
    )

    # Merge dataframes
    merged_df = pd.merge(bill_items, items_df, on='Item_Id', how='outer')

    # Calculate markup and markup percentage
    merged_df['Markup'] = merged_df['UnitPrice_Item'] - merged_df['UnitPrice_Bill']
    merged_df['Markup_Percent'] = (merged_df['Markup'] / merged_df['UnitPrice_Bill']) * 100

    return merged_df[['Item_Id', 'Item_Name', 'Markup', 'Markup_Percent']].fillna('N/A')

