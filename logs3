def analyze():
    import pandas as pd
    import json
    
    # Load the data
    with open('qb_user_data_retriever_query_Bill_5b51e4.jsonl', 'r') as file:
        bills_data = json.load(file)['QueryResponse']['Bill']

    with open('qb_user_data_retriever_query_Item_6aa95c.jsonl', 'r') as file:
        items_data = json.load(file)['QueryResponse']['Item']
    
    # Create dataframes
    bills_df = pd.json_normalize(
        [(line['ItemBasedExpenseLineDetail']['ItemRef']['value'], line['ItemBasedExpenseLineDetail']['UnitPrice']) for bill in bills_data for line in bill['Line']],
        [0],
        meta=[1],
        record_prefix='Item_'
    )
    bills_df.columns = ['Item_Id', 'UnitPrice_Bill']

    items_df = pd.json_normalize(
        items_data,
        meta=['Id', 'UnitPrice'],
        meta_prefix='Item_'
    )
    items_df.columns = ['Item_Id', 'UnitPrice_Item']

    # Merge on Item_Id
    merged_df = pd.merge(bills_df, items_df, on='Item_Id', how='inner')

    # Calculate markup
    merged_df['Markup'] = merged_df['UnitPrice_Item'] - merged_df['UnitPrice_Bill']

    return merged_df[['Item_Id', 'Markup']]

analyze()
