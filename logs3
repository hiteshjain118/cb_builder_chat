    with open('qb_user_data_retriever_query_Item_6aa95c.jsonl', 'r') as file:
        items_data = json.loads(file.read().strip().split('\n')[-1])['QueryResponse']['Item']
    
    # Create dataframes
    bills_df = pd.DataFrame(
        [(line['ItemBasedExpenseLineDetail']['ItemRef']['value'], line['ItemBasedExpenseLineDetail']['UnitPrice']) for bill in bills_data for line in bill['Line']],
        columns=['Item_Id', 'UnitPrice_Bill']
    )

    items_df = pd.DataFrame(
        [(item['Id'], item['UnitPrice'], item['Name']) for item in items_data if 'UnitPrice' in item],
        columns=['Item_Id', 'UnitPrice_Item', 'Item_Name']
    )

    # Merge on Item_Id
    merged_df = pd.merge(bills_df, items_df, on='Item_Id', how='inner')

    # Calculate markup
    merged_df['Markup'] = merged_df['UnitPrice_Item'] - merged_df['UnitPrice_Bill']
    merged_df['Markup_Percent'] = (merged_df['Markup'] / merged_df['UnitPrice_Bill']) * 100

    return merged_df[['Item_Id', 'Item_Name', 'Markup', 'Markup_Percent']]

