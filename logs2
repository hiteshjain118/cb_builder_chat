        bills_data = [json.loads(line) for line in file]

    with open('model_http_retriever_query_Invoice_1a1d9d.jsonl', 'r') as file:
        invoices_data = [json.loads(line) for line in file]

    # Extract the relevant columns for analysis
    def extract_relevant_data(data, table_type):
        records = []
        for entry in data['QueryResponse'][table_type]:
            for line in entry['Line']:
