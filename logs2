def analyze():
    import pandas as pd
    import json
    
    # Load Bill data
    with open('model_http_retriever_query_Bill_69f299.jsonl', 'r') as f:
        bill_data = [json.loads(line) for line in f]
    
    # Load Invoice data
    with open('model_http_retriever_query_Invoice_089e22.jsonl', 'r') as f:
        invoice_data = [json.loads(line) for line in f]

    # Extracting relevant parts from Bill data
    bill_lines = []
    for bill in bill_data[0]['QueryResponse']['Bill']:
        for line in bill['Line']:
            bill_lines.append({
                'ItemId': line['ItemBasedExpenseLineDetail']['ItemRef']['value'],
                'ItemName': line['ItemBasedExpenseLineDetail']['ItemRef']['name'],
                'BillQuantity': line['ItemBasedExpenseLineDetail']['Qty'],
                'BillUnitPrice': line['ItemBasedExpenseLineDetail']['UnitPrice'],
                'BillAmount': line['Amount'],
            })
    
    # Extracting relevant parts from Invoice data
    invoice_lines = []
    for invoice in invoice_data[0]['QueryResponse']['Invoice']:
        for line in invoice['Line']:
            if 'SalesItemLineDetail' in line:
                invoice_lines.append({
                    'ItemId': line['SalesItemLineDetail']['ItemRef']['value'],
                    'InvoiceQuantity': line['SalesItemLineDetail']['Qty'],
                    'InvoiceUnitPrice': line['SalesItemLineDetail']['UnitPrice'],
                    'InvoiceAmount': line['Amount'],
                })
    
    # Create DataFrames
    df_bill = pd.DataFrame(bill_lines)
    df_invoice = pd.DataFrame(invoice_lines)

    # Merge DataFrames on Item ID
    df_merged = pd.merge(df_bill, df_invoice, on='ItemId')

    # Calculate Markup
    df_merged['Markup'] = df_merged['InvoiceUnitPrice'] - df_merged['BillUnitPrice']

    # Select relevant columns for the result
    result = df_merged[['ItemId', 'ItemName', 'BillUnitPrice', 'InvoiceUnitPrice', 'Markup']]

    return result

