    # Merge the two dataframes on ItemId
    merged_df = pd.merge(bills_df, invoices_df, on='ItemId', suffixes=('_Bill', '_Invoice'))

    # Calculate the markup percentage
    merged_df['Markup%'] = ((merged_df['UnitPrice_Invoice'] - merged_df['UnitPrice_Bill']) / merged_df['UnitPrice_Bill']) * 100

    # Filter and return the relevant columns
    return merged_df[['ItemId', 'ItemName', 'Qty_Bill', 'UnitPrice_Bill', 'UnitPrice_Invoice', 'Markup%']]

