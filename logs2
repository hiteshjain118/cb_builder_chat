def analyze():
    import pandas as pd
    import json

    # Load data from jsonl files
    with open('model_http_retriever_query_Bill_c772e7.jsonl', 'r') as file:
        bills_data = [json.loads(line) for line in file]

    with open('model_http_retriever_query_Invoice_1a1d9d.jsonl', 'r') as file:
        invoices_data = [json.loads(line) for line in file]

    # Extract the relevant columns for analysis
    def extract_relevant_data(contents, table_type):
        records = []
        for entry in contents:
            for line in entry['Line']:
                if table_type == 'Bill':
                    item_ref = line['ItemBasedExpenseLineDetail']['ItemRef']
                    unit_price = line['ItemBasedExpenseLineDetail']['UnitPrice']
                    qty = line['ItemBasedExpenseLineDetail']['Qty']
                else:
                    item_ref = line['SalesItemLineDetail']['ItemRef']
                    unit_price = line['SalesItemLineDetail']['UnitPrice']
                    qty = line['SalesItemLineDetail']['Qty']
                records.append({
                    'ItemId': item_ref['value'],
                    'ItemName': item_ref['name'],
                    'Qty': qty,
                    'UnitPrice': unit_price,
                })
        return pd.DataFrame(records)

    # Extract specific data from JSON
    bills_records = bills_data[0]['QueryResponse']['Bill']
    invoices_records = invoices_data[0]['QueryResponse']['Invoice']

