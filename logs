def analyze():
    import pandas as pd
    
    # Load invoice data from the jsonl file
    df = pd.read_json('model_http_retriever_query_Invoice_b76265.jsonl', lines=True)
    
    # Initialize list to store line items
    line_items = []

    # Extract Line items and item names
    for invoice in df['QueryResponse']['Invoice']:
        for line in invoice['Line']:
            if 'SalesItemLineDetail' in line:
                line_items.append({
                    'ItemName': line['SalesItemLineDetail']['ItemRef']['name'],
                    'Amount': line['Amount']
                })

    # Create a DataFrame from line items
    line_items_df = pd.DataFrame(line_items)

    # Group by ItemName and sum the amounts
    summary = line_items_df.groupby('ItemName').sum()

    # Sort by highest selling amount
    highest_selling_products = summary.sort_values(by='Amount', ascending=False)

    # Return the highest selling products
